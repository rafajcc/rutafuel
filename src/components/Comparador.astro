---
interface Props {
  source: string;
  center: { lat: number; lon: number };
  context: string;
}

const { source, center, context } = Astro.props;
---

<section
  data-comparador
  data-source={source}
  data-center-lat={center.lat}
  data-center-lon={center.lon}
  data-context={context}
  aria-labelledby="comparador"
  class="mt-8 rounded-2xl bg-white p-5 shadow-sm dark:bg-slate-900"
>
  <h2 id="comparador" class="text-xl font-semibold">Comparar estaciones</h2>
  <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
    Ordena por precio o distancia. Los precios son los declarados por la fuente oficial.
  </p>

  <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <label class="block text-sm">
      <span class="font-medium">Combustible</span>
      <select
        data-fuel-select
        class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950"
      >
        <option value="g95">Gasolina 95 E5</option>
        <option value="g98">Gasolina 98 E5</option>
        <option value="goa">Gasóleo A</option>
        <option value="gop">Gasóleo Premium</option>
        <option value="glp">GLP</option>
      </select>
    </label>
    <label class="block text-sm">
      <span class="font-medium">Ordenar por</span>
      <select
        data-sort-select
        class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950"
      >
        <option value="price">Precio más bajo</option>
        <option value="distance">Distancia más cercana</option>
        <option value="price-radius">Precio dentro de un radio</option>
      </select>
    </label>
    <label class="block text-sm" data-radius-field hidden>
      <span class="font-medium">Radio máximo</span>
      <select
        data-radius-select
        class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950"
      >
        <option value="5">5 km</option>
        <option value="10" selected>10 km</option>
        <option value="25">25 km</option>
        <option value="50">50 km</option>
      </select>
    </label>
    <div class="flex items-end">
      <button
        type="button"
        data-geolocate
        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium dark:border-slate-700"
      >
        Usar mi ubicación
      </button>
    </div>
  </div>

  <p data-results-status role="status" class="mt-4 min-h-5 text-sm text-slate-500 dark:text-slate-400">
    Cargando estaciones…
  </p>

  <div class="mt-3 overflow-x-auto">
    <table class="w-full min-w-[36rem] text-left text-sm">
      <thead class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
        <tr>
          <th scope="col" class="py-2 pr-3">Estación</th>
          <th scope="col" class="py-2 pr-3">Precio</th>
          <th scope="col" class="py-2 pr-3">Distancia</th>
          <th scope="col" class="py-2">Enlaces</th>
        </tr>
      </thead>
      <tbody data-results-body class="divide-y divide-slate-200 dark:divide-slate-800"></tbody>
    </table>
  </div>

  <div class="mt-5">
    <button
      type="button"
      data-map-toggle
      class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white dark:bg-slate-100 dark:text-slate-900"
      aria-expanded="false"
    >
      Ver en el mapa
    </button>
    <div
      data-map-container
      hidden
      class="mt-3 h-[380px] w-full overflow-hidden rounded-xl border border-slate-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-950"
    ></div>
  </div>
</section>

<script>
  import '../scripts/comparador';
</script>
