---
interface Props {
  source: string;
  center: { lat: number; lon: number };
  context: string;
  referenceDate?: string;
  connectors: string[];
  operators: string[];
}

const { source, center, context, referenceDate, connectors, operators } = Astro.props;
---

<section
  data-charging-comparador
  data-source={source}
  data-center-lat={center.lat}
  data-center-lon={center.lon}
  data-reference-date={referenceDate ?? ''}
  aria-labelledby="comparador-recarga"
  class="mt-8 rounded-2xl bg-white p-5 shadow-sm dark:bg-slate-900"
>
  <h2 id="comparador-recarga" class="text-xl font-semibold">Comparar cargadores en {context}</h2>
  <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
    Filtra por potencia, conector u operador. La potencia es la máxima registrada por la fuente; no
    implica disponibilidad en tiempo real.
  </p>

  <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <label class="block text-sm">
      <span class="font-medium">Ordenar por</span>
      <select
        data-sort-select
        class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950"
      >
        <option value="distance">Distancia más cercana</option>
        <option value="power">Mayor potencia</option>
      </select>
    </label>
    <label class="block text-sm">
      <span class="font-medium">Tipo de recarga</span>
      <select
        data-tier-select
        class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950"
      >
        <option value="all">Todos los cargadores</option>
        <option value="slow">Carga lenta (&lt; 22 kW)</option>
        <option value="fast">Carga rápida (22–150 kW)</option>
        <option value="ultra">Ultrarrápida (≥ 150 kW)</option>
      </select>
    </label>
    <label class="block text-sm">
      <span class="font-medium">Potencia mínima</span>
      <select
        data-min-power-select
        class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950"
      >
        <option value="0">Sin mínimo</option>
        <option value="22">22 kW</option>
        <option value="50">50 kW</option>
        <option value="150">150 kW</option>
        <option value="300">300 kW</option>
      </select>
    </label>
    <label class="block text-sm">
      <span class="font-medium">Conector</span>
      <select
        data-connector-select
        class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950"
      >
        <option value="">Todos los conectores</option>
        {connectors.map((type) => <option value={type}>{type}</option>)}
      </select>
    </label>
    <label class="block text-sm">
      <span class="font-medium">Operador</span>
      <select
        data-operator-select
        class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950"
      >
        <option value="">Todos los operadores</option>
        {operators.map((operator) => <option value={operator}>{operator}</option>)}
      </select>
    </label>
    <label class="block text-sm" data-status-field hidden>
      <span class="font-medium">Estado declarado</span>
      <select
        data-status-select
        class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950"
      >
        <option value="all">Todos</option>
        <option value="operational">Operativo (según la fuente)</option>
        <option value="out-of-service">Fuera de servicio (según la fuente)</option>
      </select>
    </label>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <button
      type="button"
      data-geolocate
      class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium dark:border-slate-700"
    >
      Usar mi ubicación
    </button>
    <span class="text-xs text-slate-500 dark:text-slate-400">
      Sin permiso se usa el centro de la zona; también puedes añadir ?lat&amp;lon a la URL.
    </span>
  </div>

  <p data-results-status role="status" class="mt-4 min-h-5 text-sm text-slate-500 dark:text-slate-400">
    Cargando cargadores…
  </p>

  <div class="mt-3 overflow-x-auto">
    <table class="w-full min-w-[44rem] text-left text-sm">
      <thead class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
        <tr>
          <th scope="col" class="py-2 pr-3">Cargador</th>
          <th scope="col" class="py-2 pr-3">Operador</th>
          <th scope="col" class="py-2 pr-3">Potencia</th>
          <th scope="col" class="py-2 pr-3">Conectores</th>
          <th scope="col" class="py-2 pr-3">Distancia</th>
          <th scope="col" class="py-2">Enlaces</th>
        </tr>
      </thead>
      <tbody data-results-body class="divide-y divide-slate-200 dark:divide-slate-800"></tbody>
    </table>
  </div>

  <div class="mt-5">
    <button
      type="button"
      data-map-toggle
      class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white dark:bg-slate-100 dark:text-slate-900"
      aria-expanded="false"
    >
      Ver cargadores en el mapa
    </button>
    <div
      data-map-container
      hidden
      class="mt-3 h-[380px] w-full overflow-hidden rounded-xl border border-slate-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-950"
    ></div>
  </div>
</section>

<script>
  import '../scripts/charging-comparador';
</script>
