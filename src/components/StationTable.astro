---
import { FUEL_LABELS, formatPrice, type FuelKey } from '../lib/fuels.js';
import type { SeoStation } from '../lib/seo.js';

interface Props {
  stations: SeoStation[];
  fuel: FuelKey;
}

const { stations, fuel } = Astro.props;
---

<div class="mt-3 overflow-x-auto">
  <table class="w-full min-w-[32rem] text-left text-sm">
    <caption class="sr-only">Estaciones ordenadas por precio de {FUEL_LABELS[fuel]}</caption>
    <thead class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
      <tr>
        <th scope="col" class="py-2 pr-3">#</th>
        <th scope="col" class="py-2 pr-3">Estación</th>
        <th scope="col" class="py-2 pr-3">Localidad</th>
        <th scope="col" class="py-2">Precio</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
      {
        stations.map((station, index) => (
          <tr>
            <td class="py-2 pr-3 tabular-nums text-slate-500">{index + 1}</td>
            <td class="py-2 pr-3">
              <span class="font-medium">{station.name ?? `Estación ${station.id}`}</span>
              {station.address && (
                <span class="block text-xs text-slate-500 dark:text-slate-400">{station.address}</span>
              )}
            </td>
            <td class="py-2 pr-3">{station.locality ?? station.municipality}</td>
            <td class="py-2 font-semibold tabular-nums">
              {formatPrice(station.prices[fuel] ?? null)} €/l
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
