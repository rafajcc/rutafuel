---
interface Props {
  cheapestMunicipality?: {
    name: string;
    provinceName: string;
    url: string;
    price: number;
  };
  chargingStations: number;
  chargingMunicipalities: number;
  chargingProvinceUrl?: string;
}

const { cheapestMunicipality, chargingStations, chargingMunicipalities, chargingProvinceUrl } =
  Astro.props;
---

<section
  id="recarga"
  aria-labelledby="buscador"
  class="rounded-2xl bg-white p-5 shadow-sm sm:p-6 dark:bg-slate-900"
>
  <h2 id="buscador" class="text-xl font-semibold">¿Dónde quieres repostar?</h2>

  <div role="tablist" aria-label="Tipo de energía" class="mt-4 flex gap-2">
    <button
      type="button"
      role="tab"
      data-mode-tab="fuel"
      aria-selected="true"
      class="rounded-full bg-slate-900 px-4 py-2 text-sm font-medium text-white dark:bg-slate-100 dark:text-slate-900"
    >
      Carburantes
    </button>
    <button
      type="button"
      role="tab"
      data-mode-tab="electric"
      aria-selected="false"
      class="rounded-full border border-slate-300 px-4 py-2 text-sm font-medium dark:border-slate-700"
    >
      Recarga eléctrica
    </button>
  </div>

  <div data-mode-panel="fuel" class="mt-5">
    <label for="combustible" class="block text-sm font-medium">Combustible</label>
    <select
      id="combustible"
      data-fuel-select
      class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950"
    >
      <option value="g95">Gasolina 95 E5</option>
      <option value="g98">Gasolina 98 E5</option>
      <option value="goa">Gasóleo A</option>
      <option value="gop">Gasóleo Premium</option>
      <option value="glp">GLP</option>
    </select>

    <label for="localidad" class="mt-4 block text-sm font-medium">Localidad o código postal</label>
    <div class="mt-1 flex flex-col gap-2 sm:flex-row">
      <input
        id="localidad"
        type="search"
        list="localidades"
        autocomplete="off"
        placeholder="Ej. Alcobendas o 28100"
        class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950"
      />
      <datalist id="localidades" data-search-options></datalist>
      <button
        type="button"
        data-search-submit
        class="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800"
      >
        Buscar
      </button>
    </div>
    <p data-search-status role="status" class="mt-2 min-h-5 text-sm text-slate-500 dark:text-slate-400"></p>

    <div class="mt-4 flex flex-wrap gap-2">
      <button
        type="button"
        data-geolocate
        class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium dark:border-slate-700"
      >
        Usar mi ubicación
      </button>
      {
        cheapestMunicipality && (
          <a
            href={cheapestMunicipality.url}
            class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium dark:border-slate-700"
          >
            Ver la localidad más barata
          </a>
        )
      }
    </div>
    {
      cheapestMunicipality && (
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          Precio mínimo de gasolina 95 más bajo: {cheapestMunicipality.price.toLocaleString('es-ES', {
            minimumFractionDigits: 3,
            maximumFractionDigits: 3,
          })} €/l en {cheapestMunicipality.name} ({cheapestMunicipality.provinceName}).
        </p>
      )
    }
  </div>

  <div data-mode-panel="electric" hidden class="mt-5">
    <label for="tipo-recarga" class="block text-sm font-medium">Tipo de recarga</label>
    <select
      id="tipo-recarga"
      data-charge-select
      class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950"
    >
      <option value="all">Todos los cargadores</option>
      <option value="slow">Carga lenta (&lt; 22 kW)</option>
      <option value="fast">Carga rápida (22–150 kW)</option>
      <option value="ultra">Ultrarrápida (≥ 150 kW)</option>
    </select>

    <label for="charging-localidad" class="mt-4 block text-sm font-medium">Localidad con cargadores</label>
    <div class="mt-1 flex flex-col gap-2 sm:flex-row">
      <input
        id="charging-localidad"
        type="search"
        list="charging-localidades"
        autocomplete="off"
        placeholder="Ej. Madrid o Barcelona"
        class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950"
      />
      <datalist id="charging-localidades" data-charging-options></datalist>
      <button
        type="button"
        data-charging-submit
        class="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800"
      >
        Buscar cargadores
      </button>
    </div>
    <p data-charging-status role="status" class="mt-2 min-h-5 text-sm text-slate-500 dark:text-slate-400"></p>

    <div class="mt-4 flex flex-wrap gap-2">
      <button
        type="button"
        data-charging-geolocate
        class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium dark:border-slate-700"
      >
        Usar mi ubicación para recargar
      </button>
      {
        chargingProvinceUrl && (
          <a
            href={chargingProvinceUrl}
            class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium dark:border-slate-700"
          >
            Explorar una provincia con cargadores
          </a>
        )
      }
    </div>
    <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
      {chargingStations.toLocaleString('es-ES')} instalaciones registradas en {chargingMunicipalities.toLocaleString('es-ES')} municipios con datos suficientes. La potencia es la declarada por la fuente; no es información de disponibilidad en tiempo real.
    </p>
  </div>

  <div class="mt-6 border-t border-slate-200 pt-4 dark:border-slate-800">
    <a href="/ruta/" class="font-semibold">Planificar una ruta y encontrar estaciones por el camino →</a>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
      Calcula el recorrido por carretera y filtra gasolineras o cargadores según la geometría real de la ruta.
    </p>
  </div>
</section>

<script>
  import '../scripts/home';
</script>
