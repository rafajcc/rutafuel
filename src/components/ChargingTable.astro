---
import { connectorLabel, powerTier, POWER_TIERS } from '../lib/charging.js';
import type { ChargingStationLike } from '../lib/charging.js';

interface Props {
  stations: ChargingStationLike[];
}

const { stations } = Astro.props;
---

<div class="mt-3 overflow-x-auto">
  <table class="w-full min-w-[40rem] text-left text-sm">
    <caption class="sr-only">Cargadores ordenados por potencia máxima registrada</caption>
    <thead class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
      <tr>
        <th scope="col" class="py-2 pr-3">#</th>
        <th scope="col" class="py-2 pr-3">Cargador</th>
        <th scope="col" class="py-2 pr-3">Operador</th>
        <th scope="col" class="py-2 pr-3">Potencia</th>
        <th scope="col" class="py-2">Conectores</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
      {
        stations.map((station, index) => {
          const tier = powerTier(station.maxPowerKw);
          return (
            <tr>
              <td class="py-2 pr-3 tabular-nums text-slate-500">{index + 1}</td>
              <td class="py-2 pr-3">
                <span class="font-medium">{station.name ?? `Punto ${station.id}`}</span>
                {station.address && (
                  <span class="block text-xs text-slate-500 dark:text-slate-400">{station.address}</span>
                )}
              </td>
              <td class="py-2 pr-3">{station.operator ?? '—'}</td>
              <td class="py-2 pr-3 font-semibold tabular-nums">
                {station.maxPowerKw === null ? '—' : `${station.maxPowerKw} kW`}
                {tier !== 'unknown' && (
                  <span class="block text-xs font-normal text-slate-500">{POWER_TIERS[tier].label}</span>
                )}
              </td>
              <td class="py-2 text-xs">
                {station.connectors.map((connector) => connectorLabel(connector.type)).join(', ') || '—'}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
