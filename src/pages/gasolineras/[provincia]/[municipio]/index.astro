---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Comparador from '../../../../components/Comparador.astro';
import StationTable from '../../../../components/StationTable.astro';
import { formatPrice } from '../../../../lib/fuels.js';
import { haversineKm } from '../../../../lib/geo.js';
import { municipalityPages, provincePages } from '../../../../lib/page-data.js';
import type { MunicipalityPageDescriptor } from '../../../../lib/pages.js';
import { readMunicipalityIndex } from '../../../../lib/read-data.js';
import { breadcrumbSchema, gasStationListSchema } from '../../../../lib/seo.js';

interface Props {
  page: MunicipalityPageDescriptor;
}

export function getStaticPaths() {
  return municipalityPages.map((page) => ({
    params: { provincia: page.provinceSlug, municipio: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const index = await readMunicipalityIndex(page.provinceId, page.id);
const ranked = index.stations
  .filter((station) => station.prices.g95 !== null)
  .sort((a, b) => a.prices.g95! - b.prices.g95!)
  .slice(0, 10);
const cheapest = ranked[0];
const province = provincePages.find((item) => item.id === page.provinceId);
const difference =
  page.prices.goa.avg !== null && province?.prices.goa.avg !== null && province
    ? page.prices.goa.avg - province.prices.goa.avg
    : null;

const related = municipalityPages
  .filter((item) => item.provinceId === page.provinceId && item.id !== page.id)
  .map((item) => ({ item, distance: haversineKm(page, item) }))
  .filter(({ distance }) => Number.isFinite(distance))
  .sort((a, b) => a.distance - b.distance)
  .slice(0, 8);

const siteUrl = Astro.site?.toString() ?? 'https://rutafuel.es/';
const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Gasolineras', url: '/#provincias' },
  { name: index.provinceName ?? page.provinceName, url: `/gasolineras/${page.provinceSlug}/` },
  { name: page.name },
];
const structuredData = [
  breadcrumbSchema(crumbs, siteUrl),
  gasStationListSchema(ranked, siteUrl, 'g95', 'Gasolina 95 E5'),
];
---

<BaseLayout
  title={`Gasolineras y precios en ${page.name} (${page.provinceName}) · RutaFuel`}
  description={`Compara ${index.stationCount} gasolineras en ${page.name}, ${page.provinceName}. Precio mínimo de gasolina 95: ${formatPrice(page.prices.g95.min)} €/l. Consulta el ranking y el mapa.`}
  breadcrumbs={crumbs}
  structuredData={structuredData}
>
  <section class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-900">
    <h1 class="text-3xl font-bold tracking-tight">Gasolineras en {page.name}</h1>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{page.provinceName} · {index.stationCount} estaciones</p>
    <p class="mt-3 max-w-3xl text-slate-600 dark:text-slate-300">
      En {page.name} se han publicado precios para {page.prices.g95.count} estaciones. La gasolina 95 E5
      más barata cuesta {formatPrice(page.prices.g95.min)} €/l
      {
        cheapest?.name ? ` y se encuentra en ${cheapest.name}.` : '.'
      }
      El gasóleo A tiene un precio medio de {formatPrice(page.prices.goa.avg)} €/l
      {
        difference !== null
          ? `, ${difference >= 0 ? 'por encima' : 'por debajo'} de la media de ${page.provinceName} (${formatPrice(Math.abs(difference))} €/l).`
          : '.'
      }
      Consulta el ranking completo, ordena por distancia y abre las estaciones en el mapa.
    </p>
    <dl class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-xl bg-slate-50 p-3 dark:bg-slate-950">
        <dt class="text-xs uppercase text-slate-500">G95 mínima</dt>
        <dd class="text-xl font-bold">{formatPrice(page.prices.g95.min)} €/l</dd>
      </div>
      <div class="rounded-xl bg-slate-50 p-3 dark:bg-slate-950">
        <dt class="text-xs uppercase text-slate-500">G95 media</dt>
        <dd class="text-xl font-bold">{formatPrice(page.prices.g95.avg)} €/l</dd>
      </div>
      <div class="rounded-xl bg-slate-50 p-3 dark:bg-slate-950">
        <dt class="text-xs uppercase text-slate-500">Gasóleo A medio</dt>
        <dd class="text-xl font-bold">{formatPrice(page.prices.goa.avg)} €/l</dd>
      </div>
      <div class="rounded-xl bg-slate-50 p-3 dark:bg-slate-950">
        <dt class="text-xs uppercase text-slate-500">Estaciones</dt>
        <dd class="text-xl font-bold">{index.stationCount}</dd>
      </div>
    </dl>
  </section>

  <section aria-labelledby="ranking" class="mt-8">
    <h2 id="ranking" class="text-xl font-semibold">Las estaciones más baratas en {page.name}</h2>
    <StationTable stations={ranked} fuel="g95" />
  </section>

  <div data-ad-slot="contenido" class="ad-slot mt-8" aria-hidden="true"></div>

  <Comparador
    source={`/data/gasolineras/municipios/${page.provinceId}/${page.id}.json`}
    center={{ lat: page.lat, lon: page.lon }}
    context={page.name}
  />

  <section aria-labelledby="relacionadas" class="mt-8">
    <h2 id="relacionadas" class="text-xl font-semibold">Localidades cercanas en {page.provinceName}</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        related.map(({ item, distance }) => (
          <li>
            <a
              href={item.url}
              class="inline-block rounded-full border border-slate-300 px-3 py-1 text-sm dark:border-slate-700"
            >
              {item.name} · {Math.round(distance)} km
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">
      <a href={`/gasolineras/${page.provinceSlug}/`}>Ver todas las gasolineras de {page.provinceName}</a>
    </p>
  </section>
</BaseLayout>
