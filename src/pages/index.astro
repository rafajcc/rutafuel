---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPanel from '../components/SearchPanel.astro';
import {
  cargadores,
  metadata,
  mineturSource,
  municipalityPages,
  provincePages,
  resumen,
} from '../lib/page-data.js';
import { formatPrice } from '../lib/fuels.js';

const cheapestProvinces = [...provincePages]
  .filter((item) => item.prices.g95.min !== null)
  .sort((a, b) => a.prices.g95.min! - b.prices.g95.min!)
  .slice(0, 8);

const cheapestMunicipality = municipalityPages
  .filter((item) => item.prices.g95.min !== null)
  .sort((a, b) => a.prices.g95.min! - b.prices.g95.min!)[0];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'RutaFuel',
  url: Astro.site?.toString() ?? 'https://rutafuel.es/',
  inLanguage: 'es',
  description:
    'Comparador de precios de carburantes y puntos de recarga eléctrica en estaciones de servicio de España.',
};
---

<BaseLayout
  title="RutaFuel · Compara el combustible más barato en España"
  description="Consulta y compara los precios oficiales de gasolina, gasóleo y GLP en estaciones de servicio de España. Busca por localidad o código postal y encuentra la gasolinera más barata."
  breadcrumbs={[{ name: 'Inicio' }]}
  structuredData={structuredData}
>
  <section class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-900">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Compara el combustible en España</h1>
    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
      RutaFuel reúne los precios oficiales de las estaciones de servicio para que sepas dónde repostar
      más barato. Busca por localidad, usa tu ubicación o explora las provincias con mejores precios.
    </p>
    <p class="mt-4 inline-flex rounded-full bg-emerald-100 px-3 py-1 text-sm font-medium text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
      {resumen.totals.stations.toLocaleString('es-ES')} estaciones · {resumen.totals.provinces} provincias
    </p>
  </section>

  <div class="mt-6">
    <SearchPanel
      cheapestMunicipality={
        cheapestMunicipality
          ? {
              name: cheapestMunicipality.name,
              provinceName: cheapestMunicipality.provinceName,
              url: cheapestMunicipality.url,
              price: cheapestMunicipality.prices.g95.min!,
            }
          : undefined
      }
      chargingStations={cargadores.totals.stations}
    />
  </div>

  <section aria-labelledby="resumen" class="mt-8">
    <h2 id="resumen" class="text-xl font-semibold">Resumen de precios</h2>
    <dl class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-xl bg-white p-4 dark:bg-slate-900">
        <dt class="text-xs uppercase tracking-wide text-slate-500">Gasolina 95 mínima</dt>
        <dd class="mt-1 text-2xl font-bold">{formatPrice(resumen.prices.g95.min)} €/l</dd>
      </div>
      <div class="rounded-xl bg-white p-4 dark:bg-slate-900">
        <dt class="text-xs uppercase tracking-wide text-slate-500">Gasolina 95 media</dt>
        <dd class="mt-1 text-2xl font-bold">{formatPrice(resumen.prices.g95.avg)} €/l</dd>
      </div>
      <div class="rounded-xl bg-white p-4 dark:bg-slate-900">
        <dt class="text-xs uppercase tracking-wide text-slate-500">Gasóleo A medio</dt>
        <dd class="mt-1 text-2xl font-bold">{formatPrice(resumen.prices.goa.avg)} €/l</dd>
      </div>
      <div class="rounded-xl bg-white p-4 dark:bg-slate-900">
        <dt class="text-xs uppercase tracking-wide text-slate-500">GLP mínimo</dt>
        <dd class="mt-1 text-2xl font-bold">{formatPrice(resumen.prices.glp.min)} €/l</dd>
      </div>
    </dl>
  </section>

  <section aria-labelledby="provincias" class="mt-8">
    <h2 id="provincias" class="text-xl font-semibold">Provincias con la gasolina 95 más barata</h2>
    <ol class="mt-4 grid gap-2 sm:grid-cols-2">
      {
        cheapestProvinces.map((item) => (
          <li class="flex items-center justify-between rounded-lg bg-white px-4 py-3 dark:bg-slate-900">
            <a href={item.url}>{item.name}</a>
            <span class="font-semibold tabular-nums">{formatPrice(item.prices.g95.min)} €/l</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="estado" class="mt-8 rounded-xl border border-slate-200 p-4 text-sm text-slate-600 dark:border-slate-800 dark:text-slate-300">
    <h2 id="estado" class="font-semibold text-slate-900 dark:text-slate-100">Estado de los datos</h2>
    <p class="mt-1">
      Última actualización de la fuente: {mineturSource?.sourceUpdatedAtRaw} (hora local peninsular declarada
      por el Ministerio). Descarga: {mineturSource?.fetchedAt}.
    </p>
    <p class="mt-1">
      Durante la ingesta se descartaron {resumen.quality.discarded} registros por coordenadas inválidas
      y se detectaron {resumen.quality.duplicates} duplicados. Validación:
      <strong>{metadata.validation.ok ? 'correcta' : 'con errores'}</strong>. Los precios son
      orientativos y pueden no coincidir con el precio final en estación.
    </p>
  </section>
</BaseLayout>
