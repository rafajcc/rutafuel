# RutaFuel: sitio 100% estático. Copiado a dist/ por Astro desde public/.
# Requiere Apache 2.4 con AllowOverride adequate en Plesk (ver docs/despliegue.md).

DirectoryIndex index.html

<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

<IfModule mod_headers.c>
  # Los assets de Astro llevan hash en el nombre: se pueden cachear sin caducidad.
  <FilesMatch "^.+\.[0-9a-zA-Z_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Los JSON se regeneran con la ingesta: caché corta para no servir datos obsoletos.
  <FilesMatch "\.(json|xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
