# Cloudflare Pages: cabeceras del mismo dist/ que se sube a Apache/Plesk.
# Apache ignora este fichero (y .htaccess lo bloquea); Cloudflare ignora .htaccess.
# Las reglas se aplican en orden: la regla general va primero y las específicas
# usan "! Cache-Control" para no unir directivas conflictivas.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cache-Control: public, max-age=0, must-revalidate

/data/*
  ! Cache-Control
  Cache-Control: public, max-age=3600

/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/.htaccess
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
